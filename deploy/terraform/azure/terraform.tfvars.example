# Copy to terraform.tfvars and fill in the values with no default below.

# ---- Required, no default ----------------------------------------------------

# MARGINCE_PUBLIC_BASE_URL — the canonical external scheme+host.
public_base_url = "https://crm.example.com"

# MARGINCE_ADMIN_PASSWORD for the first boot. Rotate/remove per
# docs/deployment.md once the organization exists.
admin_bootstrap_password = "change-me-before-first-boot"

# A real release version — a git SHA, MARGINCE_RELEASE_VERSION, anything but
# "latest". Unlike the AWS stack's IMMUTABLE ECR repos, ACR does not refuse a
# re-push to the same tag (acr.tf's own comment) — "no latest" here is a
# release-discipline convention this stack asks of you, not something the
# registry enforces the way ECR does. No default on purpose.
image_tag = "2026.09.01"

# Object ID of the Entra security group that already gates the customer's
# Dataverse environment. Only its members can sign in to Margince.
entra_access_group_object_id = "00000000-0000-0000-0000-000000000000"

# Admin network(s) allowed to use password login (the break-glass account).
# Everyone else must sign in with Microsoft.
break_glass_cidrs = ["203.0.113.10/32"]

# false on the first apply; true once the asuid TXT and CNAME records exist.
bind_custom_domain = false

# Your public IP while you set up or push images from a laptop
# (curl -s https://api.ipify.org). Set back to [] afterwards.
operator_ip_allowlist = ["203.0.113.20"]

# SSH public key for the jumpbox (enable_jumpbox, default true).
jumpbox_ssh_public_key = "ssh-ed25519 AAAA... you@example.com"

# ---- Optional — shown with their defaults ------------------------------------

# azure_region             = "westeurope"
# resource_group_name      = "margince"
# name_prefix              = "margince"
# environment              = "production"  # stamped as the Environment tag on every resource
# vnet_cidr                = "10.20.0.0/16"
# az_count                 = 2
# api_min_replicas         = 2
# api_max_replicas         = 4
# worker_min_replicas      = 1
# worker_max_replicas      = 3
# api_cpu                  = 0.5
# api_memory               = "1Gi"
# worker_cpu               = 0.5
# worker_memory            = "1Gi"
# web_cpu                  = 0.25
# web_memory               = "0.5Gi"
# log_retention_days       = 30
# acr_untagged_manifest_retention_days = 14
# db_sku_name              = "B_Standard_B2s"
# db_storage_mb            = 65536
# db_version               = "16"
# db_zone_redundant_ha     = true
# db_backup_retention_days = 7
# redis_sku_name           = "Standard"
# redis_capacity           = 1
# auth_rate_limit_per_minute = 30
# create_entra_app         = true   # false: pass entra_client_id / entra_client_secret from a hand-made app
# entra_client_id          = ""
# entra_client_secret      = ""
# entra_secret_rotation_days = 180
# entra_grant_admin_consent = false # true needs Privileged Role Administrator for the Terraform identity
# license_token            = ""
# enable_deep_monitoring   = false  # true adds the action group + metric alerts (alarms.tf)
# alert_email              = ""
# enable_jumpbox             = true
# enable_bastion_developer   = true
# jumpbox_vm_size            = "Standard_B2ms"
# jumpbox_admin_username     = "margince"
# jumpbox_shutdown_time      = "2000"
# jumpbox_shutdown_timezone  = "W. Europe Standard Time"
# attachments_share_quota_gb = 100
